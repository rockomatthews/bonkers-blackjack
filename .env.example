# live: wallet-backed room entrances; practice: separate simulated ledger
BONKERS_MODE=live
# Add Supabase through Vercel Storage, then set its transaction-pooler URL server-side.
# Vercel integration may supply POSTGRES_URL automatically. Never use NEXT_PUBLIC_ for it.
POSTGRES_URL=
# Local-only fallback directory (never used on Vercel).
DATA_DIR=.data

# Shared house dealer. Never prefix these with NEXT_PUBLIC_.
# Owner default is pinned in shared/crypto/house.ts; change only deliberately.
BONKERS_HOUSE_ADDRESS=0xe8e3587b47253051Aed6e02430cdE5B1c1664B6B
BONKERS_SITE_ORIGIN=https://bonkers-blackjack.vercel.app
BONKERS_RPC_URL=https://mainnet.base.org
# Provision via Keychain + encrypted Vercel secret; never store this key here.
# BONKERS_DEALER_KEY=
# Optional dedicated seed/config store; defaults to existing server POSTGRES_URL.
# BONKERS_DEALER_DATABASE_URL=
