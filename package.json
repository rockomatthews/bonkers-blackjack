{
  "name": "bonkers-blackjack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "contracts:test": "cd contracts && forge test",
    "db:setup": "node --import tsx scripts/setup-db.ts",
    "crypto:lab": "node --import tsx scripts/crypto/lab.ts",
    "crypto:worker": "node --import tsx scripts/crypto/lab-worker.ts",
    "crypto:verify-lab": "node --import tsx scripts/crypto/verify-lab.ts",
    "crypto:verify-pilot": "node --import tsx scripts/crypto/verify-pilot.ts",
    "crypto:artifact": "cd contracts && forge build --silent && cd .. && node --import tsx scripts/crypto/export-artifact.ts",
    "crypto:pilot": "CRYPTO_LAB_ENABLED=1 next dev --hostname 127.0.0.1 --port 3107",
    "crypto:verify-v2": "node --import tsx scripts/crypto/verify-v2-local.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@noble/hashes": "1.8.0",
    "@openzeppelin/contracts": "5.6.1",
    "jose": "6.2.12",
    "lucide-react": "0.468.0",
    "next": "16.3.6",
    "pg": "8.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "three": "0.186.1",
    "viem": "2.56.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  }
}
